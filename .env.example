FETCH_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# Optional comma-separated domain allowlist. Empty means all public hosts are allowed.
FETCH_ALLOWED_DOMAINS=

# Fetch limits
FETCH_MAX_RESPONSE_BYTES=5242880
FETCH_REQUEST_TIMEOUT_SECONDS=30
FETCH_MAX_REDIRECTS=5
FETCH_REQUEST_RETRIES=3
FETCH_RETRY_BACKOFF_SECONDS=0.5
FETCH_DEFAULT_MAX_LENGTH=5000

# Fetch history / cache (backs the history:// and fetch-cache:// resources)
FETCH_MAX_HISTORY_ENTRIES=50
FETCH_MAX_CACHE_BYTES=2000000

# batch_fetch tool
FETCH_MAX_BATCH_URLS=10
FETCH_MAX_BATCH_CONCURRENCY=5

# web_search tool (DuckDuckGo HTML endpoint, no API key required)
FETCH_SEARCH_MAX_RESULTS=5
FETCH_SEARCH_TIMEOUT_SECONDS=15

# Optional SearXNG fallback for web_search (used only if DuckDuckGo fails).
# Docker Compose overrides this to http://searxng:8080 automatically.
# For local non-Docker use: http://localhost:8080 (or run `docker compose up -d searxng`).
# Set to empty to disable the fallback entirely.
FETCH_SEARXNG_URL=http://localhost:8080
FETCH_SEARXNG_TIMEOUT_SECONDS=10

# Local file tools (read_file/write_file/list_dir). Empty = disabled.
# Set this to a directory you want the server allowed to read/write in.
FETCH_LOCAL_FILES_ROOT=
FETCH_MAX_FILE_READ_BYTES=2000000
FETCH_MAX_FILE_WRITE_BYTES=2000000

# Management web GUI (dashboard). Enabled by default.
# stdio mode: http://127.0.0.1:8001/admin  |  HTTP mode: http://host:port/admin
FETCH_ADMIN_ENABLED=true
FETCH_ADMIN_HOST=127.0.0.1
FETCH_ADMIN_PORT=8001

# Required for streamable-http transport
MCP_AUTH_TOKEN=change-me-to-a-long-random-token

# HTTP rate limiting (requests per minute per token/IP)
MCP_RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO

# ----------------------------------------------------------------------
# Offline corpus / RAG (optional; install with: uv sync --extra rag)
# ----------------------------------------------------------------------
# How fetch_url / web_search / extract_links resolve requests:
#   online  - always the real network (default; behaves exactly as before)
#   offline - only the local corpus, the network is never touched
#   hybrid  - local corpus first, real network as a fallback
FETCH_NET_MODE=online

# Base URL minted for locally ingested documents. This host is answered by
# the offline resolver and is never DNS-resolved.
FETCH_SITE_BASE_URL=https://local.archive

# Local model used server-side for enrichment, categorisation and answers.
# Separate from MCP sampling, which borrows the connected client's model.
# backend: ollama | openai  (openai = any OpenAI-compatible server)
FETCH_LLM_BACKEND=ollama
FETCH_LLM_BASE_URL=http://localhost:11434
FETCH_LLM_CHAT_MODEL=gemma3:4b
FETCH_LLM_EMBED_MODEL=bge-m3
FETCH_LLM_API_KEY=
FETCH_LLM_TIMEOUT_SECONDS=120
FETCH_LLM_MAX_CONCURRENCY=2
FETCH_LLM_RETRIES=2
# How long a model stays resident in VRAM after a call (Ollama keep_alive).
FETCH_LLM_KEEP_ALIVE=5m
FETCH_LLM_NUM_CTX=8192
FETCH_LLM_EMBED_BATCH_SIZE=16

# Qdrant vector store
FETCH_QDRANT_URL=http://localhost:6333
FETCH_QDRANT_API_KEY=
FETCH_QDRANT_COLLECTION=corpus_chunks

# Corpus storage: SQLite catalog, blob store, rendered page cache, taxonomy
FETCH_CORPUS_DATA_DIR=./data

# Chunking
FETCH_CHUNK_TARGET_TOKENS=600
FETCH_CHUNK_OVERLAP_RATIO=0.15
# Headings at or above this level start a new chunk; deeper subsections
# pack together until the token budget is reached.
FETCH_CHUNK_SECTION_BREAK_LEVEL=2

# Retrieval
FETCH_RAG_TOP_K=8
FETCH_RAG_CANDIDATES=50
FETCH_RAG_RERANK_ENABLED=true
FETCH_RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
